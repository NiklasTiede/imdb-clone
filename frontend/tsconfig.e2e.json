{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node", "@playwright/test"]
  },
  "include": [
    "playwright.config.ts",
    "playwright.voice-stress.config.ts",
    "playwright.brand-review.config.ts",
    "e2e/**/*.ts",
    "scripts/**/*.ts"
  ]
}
